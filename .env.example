# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crypto_arbitrage
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Security
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WebSocket
WS_CORS_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=7f3c9a2e8d1b6f4a0c7e9d3b5a8f2c6e1d4b7a9c3f6e8d2b5a1c9e7f4d6b8a2
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET= 9a6d2f8c1e4b7a3d5f9c2e6b8a1d4f7c3e5a9b2d6f8c1e4a7b3d5f9c2e6
JWT_REFRESH_EXPIRES_IN=7d

# Cookie
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE=604800000

# Email
EMAIL_FROM=noreply@example.com
EMAIL_VERIFICATION_URL=http://localhost:3000/api/v1/auth/verify-email
RESET_PASSWORD_URL=http://localhost:3000/auth/reset-password
