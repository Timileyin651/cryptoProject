# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crypto_arbitrage
DB_USER=root
DB_PASSWORD=Sefan.ru*1
DB_DIALECT=mysql
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Security (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WebSocket
# Note: Socket.IO now uses CORS_ALLOWED_ORIGINS (same as REST CORS).
# This env var is no longer used for WebSocket CORS. Keep it for reference only.
WS_CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Cookie
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE=604800000

# Email
EMAIL_FROM=noreply@example.com
EMAIL_VERIFICATION_URL=http://localhost:3000/api/v1/auth/verify-email
RESET_PASSWORD_URL=http://localhost:3000/auth/reset-password

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CURRENCY=NGN
PAYSTACK_CALLBACK_URL=http://localhost:3000/billing/checkout-result
