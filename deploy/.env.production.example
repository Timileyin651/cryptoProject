# ════════════════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT — crypto-arbitrage-scanner
#
# Copy this file to .env and fill in real values before deploying.
# NEVER commit the .env file to version control.
#
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1

# ── Database (MySQL) ─────────────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_NAME=crypto_arbitrage
DB_USER=app
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
DB_DIALECT=mysql
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# ── Redis ────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=/app/logs

# ── Security ─────────────────────────────────────────────────────────
CORS_ORIGIN=https://yourdomain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── WebSocket ────────────────────────────────────────────────────────
WS_CORS_ORIGIN=https://yourdomain.com

# ── JWT (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ──
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_HEX_STRING
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_HEX_STRING
JWT_REFRESH_EXPIRES_IN=7d

# ── Cookie ───────────────────────────────────────────────────────────
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE=604800000

# ── Email ────────────────────────────────────────────────────────────
EMAIL_FROM=noreply@yourdomain.com
EMAIL_VERIFICATION_URL=https://yourdomain.com/api/v1/auth/verify-email
RESET_PASSWORD_URL=https://yourdomain.com/auth/reset-password

# ── Paystack ─────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_CHANGE_ME
PAYSTACK_PUBLIC_KEY=pk_live_CHANGE_ME
PAYSTACK_WEBHOOK_SECRET=whsec_CHANGE_ME
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CURRENCY=NGN
PAYSTACK_CALLBACK_URL=https://yourdomain.com/billing/checkout-result

# ── Backup ───────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=14
