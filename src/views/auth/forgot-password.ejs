<div class="layout-center">
  <div class="auth-card">
    <h1>Forgot Password</h1>
    <p class="auth-subtitle">Enter your email to receive a reset link</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <% if (typeof sent !== 'undefined' && sent) { %>
      <div class="alert alert-success">
        If an account exists with that email, a password reset link has been sent.
        Please check your inbox.
      </div>
    <% } else { %>
      <form action="/auth/forgot-password" method="POST" class="auth-form">
        <div class="form-group">
          <label for="email" class="form-label">Email</label>
          <input type="email" id="email" name="email" class="form-input" required placeholder="john@example.com">
        </div>

        <button type="submit" class="btn btn-accent btn-full">Send Reset Link</button>
      </form>
    <% } %>

    <div class="auth-links">
      <p><a href="/auth/login">Back to Sign In</a></p>
    </div>
  </div>
</div>
