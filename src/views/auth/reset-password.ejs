<div class="layout-center">
  <div class="auth-card">
    <h1>Reset Password</h1>
    <p class="auth-subtitle">Enter your new password below</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form action="/auth/reset-password" method="POST" class="auth-form">
      <input type="hidden" name="token" value="<%= typeof token !== 'undefined' ? token : '' %>">

      <div class="form-group">
        <label for="password" class="form-label">New Password</label>
        <input type="password" id="password" name="password" class="form-input" required minlength="8" placeholder="Min 8 characters">
        <small class="form-help">Must contain uppercase, lowercase, and a number</small>
      </div>

      <button type="submit" class="btn btn-accent btn-full">Reset Password</button>
    </form>

    <div class="auth-links">
      <p><a href="/auth/login">Back to Sign In</a></p>
    </div>
  </div>
</div>
