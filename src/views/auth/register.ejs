<div class="auth-container">
  <div class="auth-card">
    <h1>Create Account</h1>
    <p class="auth-subtitle">Start scanning crypto arbitrage opportunities</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form action="/auth/register" method="POST" class="auth-form">
      <div class="form-group">
        <label for="firstName">First Name</label>
        <input type="text" id="firstName" name="firstName" required maxlength="100" placeholder="John">
      </div>

      <div class="form-group">
        <label for="lastName">Last Name</label>
        <input type="text" id="lastName" name="lastName" required maxlength="100" placeholder="Doe">
      </div>

      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required placeholder="john@example.com">
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required minlength="8" placeholder="Min 8 characters">
        <small class="form-help">Must contain uppercase, lowercase, and a number</small>
      </div>

      <button type="submit" class="btn btn-primary btn-full">Create Account</button>
    </form>

    <div class="auth-links">
      <p>Already have an account? <a href="/auth/login">Sign in</a></p>
    </div>
  </div>
</div>
